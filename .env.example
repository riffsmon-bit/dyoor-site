HOODYOOR_SEADROP_V2_SECURITY_REVIEW_WAIVER=
# Exact atomic-unit rates. USDG has six decimals. Both are permanently frozen
# in the new reroll controller before the deployment can complete.
HOODYOOR_REROLL_WEI_PER_ENERGY=
HOODYOOR_REROLL_USDG_UNITS_PER_ENERGY=
# Exact format: HOODYOOR-SEADROP-V2-PRICING:<weiPerEnergy>:<usdgUnitsPerEnergy>
HOODYOOR_SEADROP_V2_PRICING_ACK=
# Exact value: HOODYOOR-SEADROP-V2-4663-IRREVERSIBLE
HOODYOOR_SEADROP_V2_BROADCAST_ACK=
# Final v2 broadcast switch; omitted/blank always produces a dry run.
EXECUTE_HOODYOOR_SEADROP_V2_DEPLOYMENT=

