HOODYOOR_SECURITY_REVIEW_WAIVER=
HOODYOOR_MINT_ENERGY_REWARD_APPROVED=
ALLOW_HOODYOOR_MAINNET=
HOODYOOR_MAINNET_ACK=
# Final broadcast switch; omitted/blank always produces a dry run.
EXECUTE_HOODYOOR_MAINNET_DEPLOYMENT=

# Release verification is keyless. BROADCAST remains false unless a separately
# authorized deployment process explicitly changes it outside verification.
RELEASE_READ_ONLY=true
BROADCAST=false

# Replacement HoodYØØR OpenSea Drop / SeaDrop v2 gates. The superseded v1
# acknowledgements do not authorize this materially different source tree.
HOODYOOR_SEADROP_V2_SOURCE_HASH=
# Use APPROVED only after a review of the exact v2 source hash. A deliberate
