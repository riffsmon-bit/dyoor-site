{
  "name": "@dyoor/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first D.Y.O.O.R browser RPG prototype",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:vite": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit --pretty false && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "metadata:scan": "tsx scripts/metadata-scan.ts",
    "traits:catalog": "tsx scripts/traits-catalog.ts",
    "registry:classify": "tsx scripts/classify-droids.ts",
    "roles:generate": "tsx scripts/rarity-and-roles.ts",
    "sprites:validate": "tsx scripts/sprites-validate.ts",
    "sprites:style-report": "tsx scripts/metadata-sprite-style-report.ts",
    "sprites:generate": "tsx scripts/sprites-generate.ts",
    "sprites:generate-all": "tsx scripts/sprites-generate-all.ts",
    "sprites:pilot:process": "tsx scripts/pilot-sprite-process.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "10.8.0",
    "@types/node": "24.10.0",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "eslint": "10.8.0",
    "globals": "16.5.0",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
