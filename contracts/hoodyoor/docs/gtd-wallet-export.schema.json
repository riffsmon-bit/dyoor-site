{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoodyoor.example/schemas/gtd-wallet-export-v1.json",
  "title": "HoodYØØR GTD wallet export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "chainId", "generatedAt", "entries"],
  "properties": {
    "schema": {
      "const": "hoodyoor-gtd-wallet-export-v1"
    },
    "chainId": {
      "const": 4663
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "maxMint",
          "message",
          "signature",
          "nonce",
          "issuedAt",
          "verified"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "maxMint": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]+$"
          },
          "domain": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "nonce": {
            "type": "string",
            "minLength": 8
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verified": {
            "const": true
          }
        }
      }
    }
  }
}
