# Copy only filled values into Netlify. Never overwrite an existing secret with
# a blank template value.

# Holder access
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
ALCHEMY_MONAD_RPC_URL=
DYOOR_WORLD_SESSION_SECRET=

# World rewards
DYOOR_WORLD_REWARDS_ENABLED=true
ENERGY_BANK_OPERATOR_PRIVATE_KEY=
DYOOR_WORLD_REWARD_SECRET=

# Verified system feeds
DYOOR_WORLD_SALES_BOT_ENABLED=true
OPENSEA_API_KEY=
DYOOR_WORLD_AUTOMATION_SECRET=

# Holder notifications
DYOOR_WORLD_PUSH_ENABLED=true
DYOOR_WORLD_VAPID_PUBLIC_KEY=
DYOOR_WORLD_VAPID_PRIVATE_KEY=
DYOOR_WORLD_VAPID_SUBJECT=https://dyoor.netlify.app

# Optional holder-only GIF search
KLIPY_API_KEY=
DYOOR_WORLD_KLIPY_CLIENT_KEY=dyoor_world

# Usually injected by Netlify; preserve existing values when already present
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
