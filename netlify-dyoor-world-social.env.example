# dYOOR World social features — Netlify import template.
# Replace every CHANGE_ME value locally. Never commit a completed copy.

# Functions/runtime scope; mark secrets in Netlify.
DYOOR_WORLD_AUTOMATION_SECRET=CHANGE_ME_64_RANDOM_HEX_CHARACTERS
DYOOR_WORLD_REWARD_SECRET=CHANGE_ME_DIFFERENT_64_RANDOM_HEX_CHARACTERS

# Keep both off until the preview passes holder, reward, and sales tests.
DYOOR_WORLD_SALES_BOT_ENABLED=false
DYOOR_WORLD_REWARDS_ENABLED=false

# Builds + Functions scope. Add after DYOORWorldTradeEscrow is deployed and verified.
NEXT_PUBLIC_DYOOR_WORLD_TRADE_ESCROW_ADDRESS=

# These existing protected variables are reused; do not create duplicate keys.
# OPENSEA_API_KEY=<existing OpenSea key>
# ENERGY_BANK_OPERATOR_PRIVATE_KEY=<existing Energy Bank CREDIT_ROLE operator>

# Direct MON tips and verified S2 PFPs require no additional environment variables.
