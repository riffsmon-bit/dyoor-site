# dYOOR World social features — Netlify import template.
# Replace every CHANGE_ME value locally. Never commit a completed copy.

# Keep both off until the preview passes holder, reward, and sales tests.
DYOOR_WORLD_SALES_BOT_ENABLED=false
DYOOR_WORLD_REWARDS_ENABLED=false

# Owner-only #announcements reuses the existing DYOOR_OWNER_ADDRESS setting.
# If it is omitted, the server reads the current owner from the S2 contract.

# Automation and daily-wheel keys are derived with separate HMAC purposes from
# the existing protected DYOOR_WORLD_SESSION_SECRET. The verified World names,
# bounty, and ownerless trade-escrow addresses are immutable code defaults.

# These existing protected variables are reused; do not create duplicate keys.
# DYOOR_WORLD_SESSION_SECRET=<existing World session secret>
# OPENSEA_API_KEY=<existing OpenSea key>
# MONADSCAN_API_KEY=<existing MonadScan key>
# ENERGY_BANK_OPERATOR_PRIVATE_KEY=<existing Energy Bank CREDIT_ROLE operator>

# Direct MON tips and verified S2 PFPs require no additional environment variables.
# Private chat image uploads reuse the existing Netlify Blobs site context.
# Reward policy is code-capped: qualifying chat earns 5 Energy up to 200
# Energy/day, tips earn 10 Energy at 0.1+ MON (3/day), completed trades earn
# 100 Energy (1/day), and each holder receives one daily wheel spin.
